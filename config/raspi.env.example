# Copy this file to .env in the repository root on the Raspberry Pi.
TRIAGO_TRANSPORT=mqtt
TRIAGO_DEVICE_ID=raspi-01
TRIAGO_MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
TRIAGO_MQTT_PORT=8883
TRIAGO_MQTT_USERNAME=raspi-publisher
TRIAGO_MQTT_PASSWORD=replace-with-publisher-password
TRIAGO_MQTT_TOPIC_PREFIX=triago/biomed
# Must be unique for each running MQTT client.
TRIAGO_MQTT_CLIENT_ID=triago-raspi-01-publisher

# Used only if TRIAGO_TRANSPORT=http.
TRIAGO_API_URL=http://127.0.0.1:5000
