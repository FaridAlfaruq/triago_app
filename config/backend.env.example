# Copy this file to .env in the repository root on the backend computer.
TRIAGO_MQTT_ENABLED=1
TRIAGO_MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
TRIAGO_MQTT_PORT=8883
TRIAGO_MQTT_USERNAME=biomed-subscriber
TRIAGO_MQTT_PASSWORD=replace-with-subscriber-password
TRIAGO_MQTT_TOPIC_PREFIX=triago/biomed
TRIAGO_MQTT_CLIENT_ID=triago-biomed-backend-01

TRIAGO_DB_HOST=localhost
TRIAGO_DB_USER=triago
TRIAGO_DB_PASSWORD=replace-with-database-password
TRIAGO_DB_NAME=triago
TRIAGO_HOST=0.0.0.0
TRIAGO_PORT=5000
TRIAGO_DEBUG=0
