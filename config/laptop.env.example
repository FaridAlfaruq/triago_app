# One laptop: backend + dashboard + demo publisher; messages use HiveMQ Cloud.
# Copy to .env at the repository root. Do not overwrite an existing .env blindly.
TRIAGO_TRANSPORT=mqtt
TRIAGO_MQTT_ENABLED=1
TRIAGO_MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
TRIAGO_MQTT_PORT=8883
# For this one-computer trial, use a credential with Publish AND Subscribe permission.
TRIAGO_MQTT_USERNAME=replace-with-your-mqtt-username
TRIAGO_MQTT_PASSWORD=replace-with-your-mqtt-password
TRIAGO_MQTT_TOPIC_PREFIX=triago/biomed
TRIAGO_DEVICE_ID=raspi-01
TRIAGO_MQTT_PUBLISHER_CLIENT_ID=triago-laptop-demo-publisher
TRIAGO_MQTT_BACKEND_CLIENT_ID=triago-laptop-backend

# Explicit trial database, automatically created; MySQL remains available separately.
TRIAGO_DB_BACKEND=sqlite
TRIAGO_HOST=127.0.0.1
TRIAGO_PORT=5000
TRIAGO_DEBUG=0

# Shared browser login. service.laptop init generates a random password locally.
TRIAGO_REQUIRE_AUTH=1
TRIAGO_DASHBOARD_USER=triago
TRIAGO_DASHBOARD_PASSWORD=replace-with-generated-dashboard-password

# Jumlah bed IGD per zona (denah U: kiri, bawah, kanan). Nomor bed berurutan.
TRIAGO_BEDS_RESUSITASI=3
TRIAGO_BEDS_DARURAT=6
TRIAGO_BEDS_NONDARURAT=3
